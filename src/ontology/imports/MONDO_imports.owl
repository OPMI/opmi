    <!-- http://purl.obolibrary.org/obo/MONDO_0008487 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0008487">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003847"/>
