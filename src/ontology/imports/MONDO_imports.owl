        <oboInOwl:hasExactSynonym>Other carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>carcinoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>carcinoma, malignant</oboInOwl:hasExactSynonym>
