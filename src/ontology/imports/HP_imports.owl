        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001626"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002597"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025031">
