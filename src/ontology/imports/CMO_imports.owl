    <!-- http://purl.obolibrary.org/obo/CMO_0003165 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003165">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney total  CD45 positive leukocyte count</rdfs:label>
