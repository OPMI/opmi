    <!-- http://purl.obolibrary.org/obo/CMO_0002759 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002759">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cardiac muscle fiber morphological measurement</rdfs:label>
