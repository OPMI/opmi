    <!-- http://purl.obolibrary.org/obo/CMO_0000994 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000994">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">velocity of circumferential fiber shortening</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000984"/>
