        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the area occupied by renal cysts is divided by the total the kidney, and the result presented as a ratio, fraction, quotient or percentage.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002980</oboInOwl:id>
