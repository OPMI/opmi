        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The distance to the lowest part of the Q wave which shows the initial downward deflection related to the initial phase of depolarization of the ventricular myocardium and the depolarization of the interventricular septum as measured by electrocardiograph.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mshimoyama</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000266 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000266">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q wave duration</rdfs:label>
