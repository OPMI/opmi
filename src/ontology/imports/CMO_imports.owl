        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-08-05T16:41:32Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any measurement of the physical form or structure of a muscle fiber, any of the cells of skeletal or cardiac muscle tissue. Each cell is one fiber of the muscle.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002533</oboInOwl:id>
