    <!-- http://purl.obolibrary.org/obo/CMO_0002977 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002977">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">afferent colloid osmotic pressure</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002970"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-27T12:53:15Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A form of osmotic pressure exerted by proteins, notably albumin, in the afferent arteriole&#39;s plasma that tends to pull water into the circulatory system. It is the opposing force to hydrostatic pressure. It has a major effect on the pressure across the glomerular filter.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002977</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0010931</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">afferent arteriolar colloid osmotic pressure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sjwang</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


