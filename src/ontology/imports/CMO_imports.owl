    <!-- http://purl.obolibrary.org/obo/CMO_0000237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000237">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aorta wall thickness</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000966"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001641"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-06-17T10:54:17Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000237</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The depth of the wall of the aorta, the main trunk from which the arterial system proceeds.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aortic wall thickness</oboInOwl:hasExactSynonym>
