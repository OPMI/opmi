    <!-- http://purl.obolibrary.org/obo/CMO_0002596 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002596">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood pressure time series linear term second order parameter</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002589"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-09-11T18:33:53Z</oboInOwl:creation_date>
