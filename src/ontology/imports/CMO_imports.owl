        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A variability measurement in which the mean is calculated from the standard deviations or the standard deviation is calculated from the means of sequential one hour diastolic blood pressure measurements.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002810</oboInOwl:id>
