    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000238 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000238">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart posterior wall thickness</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000236"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-06-17T11:13:15Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000238</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The thickness or depth of the dorsal/posterior wall of the heart. The dorsal wall is the portion of the heart muscle which is closest to the spine and farthest from the chest wall of the organism.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0007087</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart dorsal wall thickness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mshimoyama</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000239 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000239">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle posterior wall thickness</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000238"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000951"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-06-17T11:15:28Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000239</oboInOwl:id>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note that &quot;left&quot; in this context refers to the perspective of the organism, not that of the observer.</rdfs:comment>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The thickness or depth (i.e. the measurement of the two-dimensional extent of the distance between the inner and outer surfaces) of the dorsal/posterior wall of the left ventricle of the heart. The dorsal wall is the portion of the muscle enclosing the ventricle which is closest to the spine and farthest from the chest wall of the organism. The left ventricle is the lower chamber of the left side of the heart, which pumps oxygenated blood out through the aorta to all the tissues of the body.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0007087</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle dorsal wall thickness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mshimoyama</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000240">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart right ventricle posterior wall thickness</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000238"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000952"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-06-17T11:15:42Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000240</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The thickness or depth of the dorsal/posterior wall of the right ventricle of the heart. The dorsal wall is the portion of the muscle enclosing the ventricle which is closest to the spine and farthest from the chest wall of the organism.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart right ventricle dorsal wall thickness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mshimoyama</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000242">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">waist circumference</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000021"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-06-17T11:28:45Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000242</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distance completely around the body in the area between the thorax and hips. In humans, this is commonly at the umbilicus.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EFO:0004342</oboInOwl:hasDbXref>
