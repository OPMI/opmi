    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000267">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QRS duration</rdfs:label>
