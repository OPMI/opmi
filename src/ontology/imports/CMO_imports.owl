    <!-- http://purl.obolibrary.org/obo/CMO_0000699 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000699">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">absolute change in body temperature</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000015"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-03-09T04:05:52Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000699</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The difference in body temperature between two different points in time or between two different conditions.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The term &quot;absolute change&quot; refers to the subtraction of one value from another, as opposed to a dissimilarity of two values expressed as a ratio or as a percentage. In this context it is not intended to necessarily imply the difference expressed as an absolute value |n|, that is, the numeric value of the difference without regard to its sign.</rdfs:comment>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0005535</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jsmith</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


