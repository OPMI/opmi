    <!-- http://purl.obolibrary.org/obo/CMO_0002971 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002971">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arteriolar resistance</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000700"/>
