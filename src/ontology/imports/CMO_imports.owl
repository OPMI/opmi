    <!-- http://purl.obolibrary.org/obo/CMO_0000730 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000730">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood vessel dilation expressed as percent reduction of the force generated in a pre-constricted blood vessel</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000723"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-03-15T11:53:37Z</oboInOwl:creation_date>
