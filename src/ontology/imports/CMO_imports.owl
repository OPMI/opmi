        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney GSH level</oboInOwl:hasRelatedSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002236 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002236">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney malondialdehyde level</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001852"/>
