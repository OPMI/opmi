        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002810 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002810">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diastolic blood pressure variability</rdfs:label>
