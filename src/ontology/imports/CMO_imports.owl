    <!-- http://purl.obolibrary.org/obo/CMO_0001000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001000">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superficial glomerulus count</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000536"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-08-02T01:00:46Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0001000</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Count of the number of glomeruli located in the superficial layer of the renal cortex, the cortex corticis. Glomeruli are the tufts of capillaries each situated within a Bowman&#39;s capsule at the end of a renal tubule in the vertebrate kidney that filter waste products from the blood and thus initiate urine formation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0010544</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jsmith</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superficial glomeruli count</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0001001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001001">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">count of superficial glomeruli directly contacting the kidney surface</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001000"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-08-02T01:14:28Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0001001</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Count of the number of glomeruli located in the superficial layer of the renal cortex, the cortex corticis, and directly in contact with the surface of the kidney, i.e. the renal capsule. Glomeruli are the tufts of capillaries each situated within a Bowman&#39;s capsule at the end of a renal tubule in the vertebrate kidney that filter waste products from the blood and thus initiate urine formation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0010544</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jsmith</oboInOwl:created_by>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surface glomeruli count</oboInOwl:hasRelatedSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0001002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001002">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">count of superficial glomeruli not directly contacting the kidney surface</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001000"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-08-02T01:15:32Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0001002</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Count of the number of glomeruli located in the superficial layer of the renal cortex, the cortex corticis but without any direct contact with the surface of the kidney, i.e. the renal capsule. Glomeruli are the tufts of capillaries each situated within a Bowman&#39;s capsule at the end of a renal tubule in the vertebrate kidney that filter waste products from the blood and thus initiate urine formation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0010544</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jsmith</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


