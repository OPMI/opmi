    <!-- http://purl.obolibrary.org/obo/CMO_0000229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000229">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood vessel endothelial cell count</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000706"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-06-17T10:33:11Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000229</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The enumeration, i.e. measurement of the total number, of the specialized liner cells that form an interface between the circulating blood and the rest of the vessel wall in a specified sample of blood vessel, any one of the network of muscular tubes that carry blood through the body.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood vessel endothelial cell number</oboInOwl:hasExactSynonym>
