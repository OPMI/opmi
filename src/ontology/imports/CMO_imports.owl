    <!-- http://purl.obolibrary.org/obo/CMO_0000720 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000720">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated blood vessel contractile force measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000716"/>
