    <!-- http://purl.obolibrary.org/obo/CMO_0000576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000576">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood alkaline phosphatase activity level</rdfs:label>
