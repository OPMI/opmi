    <!-- http://purl.obolibrary.org/obo/CMO_0003715 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003715">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">podocyte foot process height</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001165"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-05-11T17:25:35Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003715</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:7894005</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an average value of the distance between the basal side of the podocyte contacting the basement membrane and the apical side of the podocyte projecting into the urinary space. The value is derived from the measurements of podocytes during computerized analysis of electron micrographs.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0005326</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glomerular podocyte foot process height</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glomerular visceral epithelial cell foot process height</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">podocyte pedicel height</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003716 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003716">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesangium volume per glomerulus</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002247"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-05-13T14:02:06Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003716</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:7894005</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TMV</oboInOwl:hasExactSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a calculated value made by dividing the total mesangial volume measurement by the total number of glomeruli measured, both values having been determined from measurements of microscopic images. Alternately, the fractional mesangial volume (FMV) may be multiplied by the mean glomerular volume (GV) to get the total mesangial volume (TMV).</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0005325</oboInOwl:hasDbXref>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vmes</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney mesangial volume per glomerulus</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003717 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003717">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pulse wave velocity</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003718"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-05-20T15:30:59Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003717</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carotidfemoral PWV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EFO:0004517</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EFO:0004724</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:32088716</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PWV</oboInOwl:hasExactSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pulse wave velocity (PWV) is a measurement of arterial stiffness that is an independent predictor of cardiovascular risk. It can be measured simply and noninvasively by measuring the carotid and femoral pulse pressures and the time delay between the two or by other methods relying on pulse-wave analysis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arterial stiffness measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carotid-femoral pulse wave velocity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003718 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003718">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated pulse pressure measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000292"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-05-20T15:53:45Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement which has been normalized, adjusted or derived by a mathematical process or computation, of pulse pressure, the difference between systolic and diastolic blood pressures.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003718</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:32088716</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003719 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003719">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesenteric artery wall thickness</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000966"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002849"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-05-20T16:53:26Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement of the depth of the wall of a mesenteric artery, either of two arteries arising from the aorta and passing between the two layers of the mesentery to the intestine.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003719</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:32088716</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003720 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003720">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesenteric artery media thickness</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001413"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003719"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-05-20T17:03:50Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement of the depth of the tunica media of a mesenteric artery. The tunica media is the middle layer of the mesenteric arterial wall, containing smooth muscle and elastic tissue.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003720</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:32088716</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesenteric artery tunica media thickness</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003721 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003721">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesenteric artery adventitial thickness</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003719"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-05-20T17:23:07Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement of the depth of the tunica adventitia of a mesenteric artery. The tunica adventitia is the outermost layer of the mesenteric arterial wall, composed mainly of fibrous tissue.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003721</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:32088716</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesenteric artery tunica adventitia thickness</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003724 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003724">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arteriole diameter</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002970"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-11T16:50:24Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003724</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:27270176</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The length of a line which crosses a transverse view of an arteriole, passing through its center and ending on either side at the outer surface of the arteriole wall. An arteriole is the smallest division of the artery located between the muscular arteries and capillaries.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003725 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003725">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal afferent arteriole diameter</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003724"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-11T16:57:17Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003725</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:27270176</oboInOwl:hasExactSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The length of a line which crosses a transverse view of a renal afferent arteriole, passing through its center and ending on either side at the outer surface of the arteriole wall. A renal afferent arteriole is one of the blood vessels that branch from the kidney interlobular artery and conveys blood to the glomerular capillaries.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003728 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003728">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">negative logarithm of the molar concentration of acetylcholine at which the reduction in force during dilation of a blood vessel is half the maximum value</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000724"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-18T15:57:10Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated value for the negative logarithm of the molar concentration of acetylcholine (ACh), which acts as a neurotransmitter, at which the dilation of a blood vessel in response to the application of ACh is half maximal. The logarithm of the concentration is the exponent indicating the power to which 10 must be raised to obtain that concentration value.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACh pD2</oboInOwl:hasExactSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003728</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:32088716</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acetylcholine -Log EC50</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acetylcholine -Log half maximal effective concentration (-Log EC50)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003740 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003740">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart fibrotic lesion measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000861"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-29T12:19:38Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any measurement of a lesion in the heart characterized by an abnormal proliferation of fibrous connective tissue. A lesion is a localized pathological change in structure of an organ or tissue due to injury or disease; especially one that is circumscribed and well defined.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003740</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:20864942</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003741 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003741">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle fibrotic lesion measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003740"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-29T12:29:24Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any measurement of a lesion in the left ventricle of the heart characterized by an abnormal proliferation of fibrous connective tissue. A lesion is a localized pathological change in structure of an organ or tissue due to injury or disease; especially one that is circumscribed and well defined.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003741</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:20864942</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003742 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003742">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle fibrotic lesion size measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003741"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-29T12:34:47Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003742</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:20864942</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is any measurement of the physical dimensions, proportions, magnitude, or extent of a lesion in the left ventricle of the heart characterized by an abnormal proliferation of fibrous connective tissue. A lesion is a localized pathological change in structure of an organ or tissue due to injury or disease; especially one that is circumscribed and well defined.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003743 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003743">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle fibrotic lesion area measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003742"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-29T12:49:29Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003743</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:20864942</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a measurement of the extent of a two-dimensional surface of or plane through a single heart left ventricle fibrotic lesion, or a measurement of the total area occupied by fibrotic lesions in a cross-section of the heart left ventricle.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003744 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003744">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated heart left ventricle fibrotic lesion area measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003743"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-29T12:53:13Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003744</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:20864942</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a measurement of the extent of a two-dimensional surface of or plane through a single heart left ventricle fibrotic lesion, or a measurement of the total area occupied by fibrotic lesions in a cross-section of the heart left ventricle, when that value has been normalized, adjusted or derived by a mathematical process or computation.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003745 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003745">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle interstitial fibrotic lesion area to total heart left ventricule area ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003744"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-29T13:09:59Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003745</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:20864942</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a calculated value in which the extent of the two-dimensional surface occupied by interstitial fibrotic lesions is divided by the total extent of the two-dimensional surface of the heart left ventricle and presented as a ratio, fraction, quotient or percentage, thus normalizing it to the size of the heart left ventricle.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003746 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003746">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle perivascular fibrotic lesion area to total heart left ventricule area ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003744"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-29T13:13:15Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003746</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:20864942</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is calculated value in which the extent of the two-dimensional surface occupied by perivascular fibrotic lesions is divided by the total extent of the two-dimensional surface of the heart left ventricle and presented as a ratio, fraction, quotient or percentage, thus normalizing it to the size of the heart left ventricle.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003747 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003747">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney interstitial fibrotic lesion area to total kidney area ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001257"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-29T13:30:36Z</oboInOwl:creation_date>
        <oboInOwl:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0001258</oboInOwl:hasAlternativeId>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003747</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:20864942</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This measurement is a calculated value in which the extent of the two-dimensional area occupied by fibrotic lesions is divided by the total extent of the two-dimensional area of the kidney and presented as a ratio, fraction, quotient or percentage, thus normalizing it to the size of the kidney. The two-dimensional measurements are made on microscopic images.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney fibrotic lesion cross-sectional area to total kidney cross-sectional area ratio</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003748 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003748">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glomerular volume per podocyte</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003711"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-29T15:56:32Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the average volume of kidney glomeruli is divided by the average number of podocytes in a glomerulus. It represents the reciprocal value of &#39;number of podocytes to glomerular volume ratio (CMO:0002955).</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003748</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:18199599</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003749 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003749">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Darcy permeability</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003420"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-01T13:46:56Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003749</oboInOwl:id>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Darcy permeability of GBM layers</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:10703671</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This measurement defines the capacity of a porous material to transmit fluids. Darcy&#39;s law is an equation that describes the flow of a fluid through a porous medium. The calculation in biological systems relies on a pressure gradient, the thickness of the material through which the fluid is proceeding, and the dynamic viscosity of the filtration solution.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003750 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003750">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volume of glomerular capillary tuft not affected by sclerosis</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002247"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002947"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-02T10:56:41Z</oboInOwl:creation_date>
