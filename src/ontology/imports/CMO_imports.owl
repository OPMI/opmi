        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EFO:0009865</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Not4Curation</oboInOwl:hasRelatedSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is any measurement of the absolute or relative amount(s) of one or more of the ribonucleic acids (RNAs) found in a specified tissue.</obo:IAO_0000115>
