    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002534">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skeletal muscle fiber morphological measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001147"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002533"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-08-05T16:42:27Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any measurementof the physical form or structure of a skeletal muscle fiber, a cylindrical multinucleate cell of skeletal muscle tissue containing contracting myofibrils and across which run transverse striations.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002534</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBA:2045268</oboInOwl:hasDbXref>
