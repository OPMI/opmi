        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Calculated value for average volume of glomerular capillary tuft not affected by sclerotic changes in sampled subjects.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:16395266</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volume of normal glomerular capillary tuft</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003751 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003751">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volume of glomerular capillary tuft occupied by sclerosis</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002247"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002947"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-02T11:13:51Z</oboInOwl:creation_date>
