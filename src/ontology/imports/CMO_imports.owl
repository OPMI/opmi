        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney cortex volume</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sjwang</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003028">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal medulla volume</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001179"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-02-14T13:52:03Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A morphological measurement of the size, volume, of the renal medulla, the innermost part of the kidney which contains the structures of the nephrons responsible for maintaining the salt and water balance of the blood.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003028</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0003014</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney medulla volume</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sjwang</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003100">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">platelet morphological measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000035"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/cmo#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CMO_0000036"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-04-16T11:29:25Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any measurement of the physical form or structure of platelets, the disk-shaped structures found in the blood of mammals which play a vital role in blood coagulation. Platelets lack nuclei and DNA but contain active enzymes and mitochondria.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003100</oboInOwl:id>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sjwang</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003145">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single kidney weight to tibia length ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001951"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-04-29T13:35:22Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the weight of one kidney is divided by the length of tibia, and the result presented as a ratio, fraction, quotient or percentage, thus normalizing it to tibia length.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003145</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0002707</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sjwang</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003160">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood C-reactive protein level</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000028"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-06T10:30:17Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C-reactive protein measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003160</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EFO:0004458</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The proportion, quantity, or volume of C-reactive protein (CRP) found in the blood. CRP is an acute phase reactant protein used to indicate inflammatory illness. It is believed to be of value in predicting coronary events.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood CRP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sjwang</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


