        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">waist girth</oboInOwl:hasRelatedSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000256">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">urine measurement</rdfs:label>
