        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The time from start to finish of the QRS interval as calculated from a set of measurements taken from the beginning of the QRS complex to the end of the QRS complex representing the time it takes for ventricles to depolarize.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:2000017</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
