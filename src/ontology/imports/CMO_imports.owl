        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Defined as the work performed by the left or right ventricle to eject the stroke volume into the aorta or pulmonary artery, respectively.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
