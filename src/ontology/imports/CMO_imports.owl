    <!-- http://purl.obolibrary.org/obo/CMO_0000160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000160">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated kidney weight</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000081"/>
