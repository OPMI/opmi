        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The experimental set point parameter of the blood pressure time series baroreceptor response calculation.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
