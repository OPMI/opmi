        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:16395266</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003752 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003752">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volume of kidney cortical interstitium to total volume of kidney cortex ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002947"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-02T11:54:47Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the average volume of interstitial space in the renal cortex is divided by the average total volume of the renal cortex and the result presented as a ratio, fraction, quotient or percentage, thus normalizing it to kidney cortical volume and, by extension, to the size of the kidney.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003752</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:16395266</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volume of interstitial kidney cortex to total volume of kidney cortex ratio</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003756 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003756">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle infarction area to total heart left ventricle area ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000693"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-02T18:31:48Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the area of a heart left ventricle infarction is divided by the total area of the heart left ventricle, and the result presented as a ratio, fraction, quotient or percentage, thus normalizing it to heart left ventricle size and, by extension, to the size of the heart.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003756</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:14962492</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:22258067</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003797 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003797">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of glomeruli per kidney</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003798"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-22T15:56:54Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003797</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:17167120</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The number of glomeruli calculated to be in one kidney from a measured sample of that kidney. Glomeruli are the tufts of capillaries each situated within a Bowman&#39;s capsule at the end of a renal tubule in the vertebrate kidney that filter waste products from the blood and thus initiate urine formation.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glomerulus count per kidney</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003798 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003798">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated kidney glomerulus count</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000536"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002817"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-22T16:02:09Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any count that has been normalized, adjusted or derived by a mathematical process or computation, of the glomeruli of one or both kidneys, the paired organ which functions to maintain proper water and electrolyte balance, regulate acid-base concentration, and filter the blood of metabolic wastes.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003798</oboInOwl:id>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Not4Curation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:23241663</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated glomerulus count</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated renal glomerulus count</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003799 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003799">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of glomeruli per volume of kidney</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003798"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-22T16:41:13Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A count that has been normalized, adjusted or derived by a mathematical process or computation, of the glomeruli in a given volume of kidney tissue.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003799</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:23241663</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of kidney glomeruli per volume of tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003811 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003811">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal cortex morphological measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000087"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001178"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-27T17:26:08Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003811</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measurement of the physical form or structure of the renal cortex, the outer part of the kidney, composed mainly of glomeruli and convoluted tubules.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:3199667</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney cortex morphological measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003812 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003812">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal cortex cross-sectional area</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003811"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-27T17:46:05Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement of the outer extent of a plane perpendicular through the hilum, the opening on the medial margin of the kidney leading into the renal sinus. Its value may be calculated from or measured via a microscopic image.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003812</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:3199667</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney cortex cross-sectional area</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003813 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003813">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carotid artery blood flow velocity</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001477"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-29T15:24:26Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003813</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measurement of average carotid artery blood flow velocity, the speed with which blood moves along the circulation in any particular segment of carotid artery. Blood flow velocity is related directly to blood flow and inversely to cross-sectional area. Blood flow velocity can be measured indirectly by Doppler ultrasound</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:29498562</oboInOwl:hasDbXref>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carotid flow velocity</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean carotid artery blood flow velocity</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003814 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003814">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak carotid artery blood flow velocity</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001477"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-29T15:31:59Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003814</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measurement of peak carotid artery blood flow velocity, the top speed (systolic) with which blood moves along the circulation in any particular segment of carotid artery. Blood flow velocity is related directly to blood flow and inversely to cross-sectional area. Blood flow velocity can be measured indirectly by Doppler ultrasound</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:29498562</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak (systolic) flow velocity</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak carotid artery flow velocity</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003815 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003815">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cerebral blood flow rate</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000196"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001969"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-07-29T16:36:46Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CBF rate</oboInOwl:hasExactSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003815</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebral blood flow (CBF) rate is the volume of blood delivered to or exiting the brain, through a network of cerebral arteries and veins, per unit time</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EFO:0007980</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:27403447</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:29498562</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cerebral blood flow measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003837 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003837">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated capillary measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002536"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-08-27T17:18:03Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any measurement which has been normalized or adjusted by a mathematical process or computation of the minute vessels connecting arterioles and venules, the walls of which act as a semipermeable membrane for interchange of various substances between the blood and tissue fluid.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003837</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:22258067</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003838 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003838">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of capillaries per cross-sectional area of left ventricular myocardium</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003837"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-08-27T17:28:15Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated number of capillaries associated with a sampled cross-sectional area of left ventricular myocardium, the muscular layer of the ventricle. Capillaries are the minute vessels connecting arterioles and venules, the walls of which act as a semipermeable membrane for interchange of various substances between the blood and tissue fluid.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003838</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:22258067</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0010945</oboInOwl:hasDbXref>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">capillary density</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003840 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003840">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cardiac myocyte cross-sectional area</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002759"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-09-09T18:12:17Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement of the extent of a plane through, that is, perpendicular to the axis of, a cardiac myocyte, striated muscle cells that are responsible for heart contraction. In mammals, the contractile fiber resembles those of skeletal muscle but are only one third as large in diameter, are richer in sarcoplasm, and contain centrally located instead of peripheral nuclei.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003840</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:22258067</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cardiac fiber cross-sectional area</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cardiac muscle fiber cross-sectional area</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cardiomyocyte cross-sectional area</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart muscle cell cross-sectional area</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">striated cardiac muscle cell cross-sectional area</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003848 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003848">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of ureteric bud tips per kidney</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002947"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-11T16:34:29Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003848</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:22871889</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a measurement of the number of ureteric bud tips calculated to be in one kidney from a measured sample of that kidney. Ureteric bud tips are at the terminal ends of the ureteric tree. The ureteric tip cells are proliferating immature cells located at the branching points that induce the adjacent cap mesenchyme to undergo nephrogenesis.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ureteric bud tip count per kidney</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003849 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003849">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of glomeruli per kidney to number of ureteric bud tips per kidney ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002947"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003798"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-11T17:17:48Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the average number of glomeruli calculated to be in one kidney is divided by the average number of ureteric bud tips calculated to be in one kidney and the result presented as a ratio, fraction, quotient or percentage, thus normalizing it to one kidney.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003849</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:22871889</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">count of glomeruli per kidney to count of ureteric bud tips per kidney ratio</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003850 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003850">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total kidney protein to kidney weight ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001182"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-21T18:44:50Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated value in which the total amount of protein in a kidney is divided by the total weight of the body and presented as a ratio thus normalizing it to body weight.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003850</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:2838080</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total weight of kidney protein to whole kidney weight ratio</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003851 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003851">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle end-systolic internal diameter</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000983"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-26T15:27:30Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003851</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LVIDs</oboInOwl:hasExactSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The diameter across the inside of the left ventricle of the heart at the end of systole, that is, when the heart muscle is maximally contracted, and usually corresponds to its smallest diameter.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricular end-systolic internal diameter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">left ventricular internal dimension at systole</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003864 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003864">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volume of glomerular capillary tuft occupied by sclerosis to volume of total glomerular capillary tuft ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002247"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002947"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-11-05T17:36:50Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the average volume of glomerular capillary tuft occupied by sclerotic changes is divided by the total average total volume of glomerular capillary tuft with the result presented as a ratio, fraction, quotient or percentage, thus normalizing it to total of glomerular capillary tuft volume.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003864</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:16395266</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">percentage of tuft volume affected by sclerosis</oboInOwl:hasNarrowSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003865 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003865">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">healthy glomeruli to total glomeruli ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002947"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-11-05T18:01:34Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the average number of healthy glomeruli per subject is divided by the average total number of glomeruli per subject with the result presented as a ratio, fraction, quotient or percentage, thus normalizing it to total number of glomeruli.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003865</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:16395266</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003869 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003869">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle plus septum weight to body weight ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001123"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003400"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-11-19T17:25:30Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated value in which sum of the weight of the left ventricle and the weight of the interventricular septum is divided by the total weight of the body with the result presented as a ratio, fraction, quotient or percentage, thus normalizing it to body weight and by extension to the size of the organism.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003869</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LV+SEP/BW</oboInOwl:hasExactSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:15721482</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003876 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003876">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood urea level</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000023"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-02-25T09:23:49Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003876</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the level of urea in the blood; converted from urea nitrogen to urea concentration by multiplying urea nitrogen concentration by 60/28 or 2.14. Urea is the chief nitrogenous end product of protein metabolism in whole blood. Urea is formed in the liver from amino acids and from ammonia compounds and can be found in urine, blood, and lymph.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood urea concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003895 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003895">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated mean arterial blood pressure measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000009"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-07-08T15:09:23Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003895</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:15458950</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a measurement which has been normalized, adjusted or derived by a mathematical process or computation, of mean arterial blood pressure, the average blood pressure within an artery over a specified period of time.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003896 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003896">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">range of heart rate variation during variation of mean arterial blood pressure</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002161"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-07-11T16:35:24Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003896</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This calculated measurement is the range of change in heart rate (the number of contractions of the cardiac ventricles per unit of time) relative to the change in mean arterial blood pressure (the average force the blood exerts on an artery wall) over time and/or in response to a change in conditions.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">range of change in HR during changes in MAP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">range of change in heart rate during changes in mean arterial blood pressure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">range of variation in HR during variation in MAP</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003904 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003904">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">change in heart rate to change in vasoactive chemical dose ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002161"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-09-20T17:08:47Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003904</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a calculated measurement in which the difference in the heart rate recorded between two or more dosages of a drug or chemical which reduces or increases the interior diameter of blood vessels is divided by the difference of the applied dosages and presented as a ratio, fraction, quotient or percentage. The value is calculated as the slope of the curve of the heart rate versus the chemical dose graph.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">beta coefficent of the heart rate/ vasoactive chemical dose curve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">index of baroreceptor sensitivity</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slope of the heart rate/ vasoactive chemical dose curve</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003905 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003905">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">area of atherosclerotic lesion to total artery area ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000976"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-09-29T09:47:33Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003905</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:28469073</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is calculated value in which the extent of the two-dimensional surface occupied by atherosclerotic lesion(s) is divided by the total extent of the two-dimensional surface of the artery and presented as a ratio, fraction, quotient or percentage, thus normalizing it to the size of the artery.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">atherosclerotic area as percentage of total</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">average atherosclerotic area</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lesioned artery area to total artery area ratio</oboInOwl:hasBroadSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003906 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003906">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coronary perfusion pressure</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000008"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-10-10T13:14:15Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003906</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CPP</oboInOwl:hasExactSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a calculated measurement of the pressure gradient that drives coronary blood pressure. CPP can be measured by calculating the difference between the aortic pressure and the left ventricular end diastolic pressure: Coronary Perfusion Pressure (CPP) = Aortic Diastolic Pressure  Left Ventricular end-diastolic Pressure (LVEDP).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003907 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003907">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coronary blood flow rate</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000198"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-10-10T13:42:52Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003907</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The is a measurement of the amount of blood perfusing the heart muscle through the coronary arteries per unit time.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003908 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003908">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coronary blood flow rate to heart weight ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001543"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003907"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-10-10T13:49:52Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003908</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The is a measurement of the amount of blood perfusing the heart muscle through the coronary arteries per unit time, divided by the total weight of the heart, and the result presented as a ratio, fraction, quotient or percentage, thus normalizing coronary blood flow rate to heart weight.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coronary blood flow per gram of heart tissue</oboInOwl:hasNarrowSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003911 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003911">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney nucleic acid measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001852"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-03-13T17:03:59Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003911</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is quantification of a morphological or physiological parameter of one or more nucleic acids in a specified sample of kidney tissue, that is, tissue from one or both of the paired organs which function to maintain proper water and electrolyte balance, regulate acid-base concentration, and filter the blood of metabolic wastes. Nucleic acids are high-molecular-weight polymeric compounds composed of nucleotides, each consisting of a purine or pyrimidine base, a ribose or deoxyribose sugar, and a phosphate group, and are involved in the determination and transmission of genetic characteristics.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal nucleic acid measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003912 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003912">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney ribonucleic acid level</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002793"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003911"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-03-13T17:13:14Z</oboInOwl:creation_date>
        <oboInOwl:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002797</oboInOwl:hasAlternativeId>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003912</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is any measurement of the absolute or relative amount(s) of one or more of the ribonucleic acids (RNAs) that reside in the kidney. Ribonucleic acids are high-molecular-weight polymeric compounds composed of nucleotides, each consisting of a purine or pyrimidine base, a ribose sugar, and a phosphate group. They are involved in the determination and transmission of genetic characteristics.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0010793</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney RNA composition measurement</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney ribonucleic acid composition measurement</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal RNA level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal ribonucleic acid level</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003913 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003913">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney mRNA level</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003912"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-03-13T17:18:54Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003913</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the measurement of the amount of messenger ribonucleic acid (mRNA) which codes for the amino acid sequences of proteins in a specified sample of kidney.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney messenger RNA level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney messenger ribonucleic acid level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal mRNA level</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003942 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003942">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total body water mass</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001196"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-08-11T17:07:21Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003942</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:37191987</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBW weight</oboInOwl:hasExactSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This measurement is a calculated/estimated value of the relative mass of total fluid in an organism. The two main fluid compartments are divided by the cell membrane into the extracellular fluid (ECF) and the intracellular fluid (ICF).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total body fluid mass</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total body fluid weight</oboInOwl:hasRelatedSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003944 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003944">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total body fat-free mass</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001196"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-08-21T13:38:35Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003944</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:37191987</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a measurement that determines whole body lean tissue mass of an organism by subtracting whole body fat mass from total body mass.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total body fat-free weight</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">whole body fat-free mass</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003960 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003960">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney glomerulus area</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002817"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-09-29T14:35:28Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003960</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a calculated measurement of the average cross-sectional area of glomeruli sampled in microscopic images.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">average kidney glomerulus cross-sectional area</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney glomerular area</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003961 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003961">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney cortex damaged tubule count to kidney cortex total tubule count ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002947"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-09-29T15:03:57Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003961</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a calculated measurement in which the average number of damaged kidney cortex tubules per subject is divided by the average total number of kidney cortex tubules per subject with the result presented as a ratio, thus normalizing the number of damaged tubules to total number of tubules.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">percentage of damaged kidney cortex tubules</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">percentage of damaged renal cortex tubules</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal cortex damaged tubule count to renal cortex total tubule count ratio</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003962 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003962">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney medulla damaged tubule count to kidney medulla total tubule count ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002947"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-09-29T15:17:14Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003962</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a calculated measurement in which the average number of damaged kidney medulla tubules per subject is divided by the average total number of kidney medulla tubules per subject with the result presented as a ratio, thus normalizing the number of damaged tubules to the total number of tubules.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">percentage of damaged kidney medulla tubules</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">percentage of damaged renal medulla tubules</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal medulla damaged tubule count to renal medulla total tubule count ratio</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003978 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003978">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vena cava morphological measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0004031"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-03-05T14:21:38Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003978</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:36733943</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is any quantification of the physical form or structure of the largest veins (superior vena cava and inferior vena cava in mammals) which deliver de-oxygenated blood from throughout the body back to the right cardiac atrium.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">caval vein morphological measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulederkind</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">venae cavae morphological measurement</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003979 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003979">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vena cava molecular composition measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003978"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-03-05T14:30:56Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003979</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:36733943</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is any quantitation of the molecules, atoms and/or ions which constitute the chemical make-up of the largest veins (superior vena cava and inferior vena cava in mammals) which deliver de-oxygenated blood from throughout the body back to the right cardiac atrium.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">caval vein molecular composition measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulederkind</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">venae cavae molecular composition measurement</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003980 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003980">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vena cava ribonucleic acid level</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003979"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-03-05T15:08:39Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003980</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:36733943</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is any measurement of the absolute or relative amount(s) of one or more of the ribonucleic acids (RNAs) found in the largest veins (superior vena cava and inferior vena cava in mammals) which deliver de-oxygenated blood from throughout the body back to the right cardiac atrium.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">caval vein RNA level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">caval vein ribonucleic acid level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulederkind</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vena cava RNA level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">venae cavae RNA level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">venae cavae ribonucleic acid level</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003984 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003984">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart right atrium ribonucleic acid level</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002933"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-04-02T13:51:49Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003984</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a measurement of the amount of ribonucleic acid (RNA), the molecule composed of the sugar ribose, phosphate groups and any combination of the bases adenine, guanine, cytosine, and/or uracil, extracted from or contained in the heart right atrium, the upper chamber of the right side of the heart, which receives deoxygenated blood from the venae cavae and the coronary sinus, and pumps it into the right ventricle through the tricuspid valve.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0011109</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart right atrium RNA level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart right atrium ribonucleic acid amount</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">right cardiac atrium RNA level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">right cardiac atrium ribonucleic acid amount</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulederkind</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003997 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003997">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximim inner diameter of middle cerebral artery perfused in bicarbonate-buffered, calcium-free saline</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001128"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-06-04T11:15:45Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003997</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dmax</oboInOwl:hasExactSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an ex vivo measurement of the length of a line which crosses a transverse view of a calcium-free physiological salt solution (PSS)-perfused (80 mmHg equilibrium pressure) middle cerebral artery, passing through its center and ending on either side at the inner surface of the blood vessel wall. The middle cerebral arteries are the largest of the cerebral arteries and supply blood to the lateral cerebral cortex, anterior temporal lobes and insular cortices of the brain.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximim diameter of middle cerebral artery perfused in bicarbonate-buffered, calcium-free saline</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximim lumen diameter of middle cerebral artery perfused in bicarbonate-buffered, calcium-free PSS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum inner diameter of MCA perfused in calcium-free PSS</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulederkind</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003998 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003998">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resting inner diameter of middle cerebral artery perfused in bicarbonate-buffered, normal saline</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001128"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-06-04T12:15:20Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003998</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Drest</oboInOwl:hasExactSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an ex vivo measurement of the length of a line which crosses a transverse view of a saline-perfused (80 mmHg equilibrium pressure) middle cerebral artery, passing through its center and ending on either side at the inner surface of the blood vessel wall. The middle cerebral arteries are the largest of the cerebral arteries and supply blood to the lateral cerebral cortex, anterior temporal lobes and insular cortices of the brain.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lumen diameter of middle cerebral artery perfused in bicarbonate-buffered, normal saline</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resting diameter of middle cerebral artery perfused in bicarbonate-buffered, normal physiological salt solution</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resting inner diameter of MCA perfused in normal PSS</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulederkind</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0004031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0004031">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vein morphological measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001997"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-11-18T16:36:50Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0004031</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is any quantification of the physical form or structure of a vein, any of the tubular branching vessels that carry blood from the capillaries toward the heart.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulederkind</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0004032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0004032">
