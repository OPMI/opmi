    <!-- http://purl.obolibrary.org/obo/CMO_0003482 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003482">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle interstitial angiotensin II level during a period of time</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003246"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-06-29T14:03:57Z</oboInOwl:creation_date>
