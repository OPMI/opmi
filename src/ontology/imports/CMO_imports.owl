        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tissue RNA level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tissue ribonucleic acid composition measurement</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transcriptome measurement</oboInOwl:hasNarrowSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002809 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002809">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">systolic blood pressure variability</rdfs:label>
