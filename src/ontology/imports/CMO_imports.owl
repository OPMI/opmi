    <!-- http://purl.obolibrary.org/obo/CMO_0002943 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002943">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">renal filtration fraction</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001917"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002931"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-07T14:45:56Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002943</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FF</oboInOwl:hasExactSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Filtration fraction is the ratio of the glomerular filtration rate (GFR) to the renal plasma flow (RPF). Filtration Fraction, FF = GFR/RPF. The filtration fraction, therefore, represents the proportion of the fluid reaching the kidneys which passes into the renal tubules.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:2846658</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0002847</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filtration fraction</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sjwang</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


