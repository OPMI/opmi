    <!-- http://purl.obolibrary.org/obo/CMO_0000304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000304">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fat mass index (FMI)</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000089"/>
