    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000577">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">serum alkaline phosphatase activity level</rdfs:label>
