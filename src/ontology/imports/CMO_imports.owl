        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The magnitude of the portion of the electrocardiograph comprising the Q, R, and S waves which together represent ventricular depolarization.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
