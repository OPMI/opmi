        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the weight of copper in a specified sample of kidney is divided by the dry weight of that kidney sample, that is, the weight of the sample after dessication, and presented as a ratio, fraction, quotient or percentage.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003478</oboInOwl:id>
