    <!-- http://purl.obolibrary.org/obo/CMO_0002931 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002931">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated glomerular filtration rate</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000490"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-07T10:37:27Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any measurement which has been normalized, adjusted or derived by a mathematical process or computation, of the volume of fluid filtered from the kidney glomerular capillaries into the Bowman&#39;s capsule per specified unit of time based on a blood solute level, weight and age of organism and other factors.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002931</oboInOwl:id>
