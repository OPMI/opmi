        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jsmith</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002230">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney paraoxonase1 activity to total protein level ratio</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003423"/>
