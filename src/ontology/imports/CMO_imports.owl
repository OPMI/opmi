    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002760 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002760">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cardiac muscle fiber diameter</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002759"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-07-20T13:43:26Z</oboInOwl:creation_date>
