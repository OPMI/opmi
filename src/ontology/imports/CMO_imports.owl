        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart right ventricle deoxyribonucleic acid composition measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002938"/>
