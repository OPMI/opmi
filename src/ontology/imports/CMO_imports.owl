    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000269 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000269">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QTC interval</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000230"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-06-17T12:40:52Z</oboInOwl:creation_date>
