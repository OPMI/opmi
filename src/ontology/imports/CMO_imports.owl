        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The total amount of body fat calculated as fat mass index equal to fat weight divided by height squared.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mshimoyama</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000305">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total body fat mass</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000089"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-08-05T09:19:24Z</oboInOwl:creation_date>
