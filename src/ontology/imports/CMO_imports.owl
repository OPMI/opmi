    <!-- http://purl.obolibrary.org/obo/CMO_0000492 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000492">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood glomerular filtration rate, Chronic Kidney Disease Epidemiology Collaboration formula (CKE-EPI)</rdfs:label>
