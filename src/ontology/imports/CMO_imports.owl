        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval between an R wave and the next R wave of successive heart beats, inverse of the heart rate.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RR_Interval</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:2000017</oboInOwl:hasDbXref>
