    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002811 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002811">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean arterial blood pressure variability</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000009"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-11-13T15:04:28Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A variability measurement in which the mean is calculated from the standard deviations or the standard deviation is calculated from the means of sequential one hour mean arterial blood pressure measurements.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002811</oboInOwl:id>
