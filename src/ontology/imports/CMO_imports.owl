    <!-- http://purl.obolibrary.org/obo/CMO_0003244 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003244">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio of the area occupied by interstitial collagen to the total area of the heart left ventricle</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000984"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-10-03T15:44:41Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the area of the heart left ventricle occupied by interstitial collagen is divided by the total area of the heart left ventricle, and the result presented as a ratio, fraction, quotient or percentage.</obo:IAO_0000115>
