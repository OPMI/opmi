    <!-- http://purl.obolibrary.org/obo/CMO_0000257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000257">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">urine specific gravity</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000256"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-06-17T12:27:01Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000257</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This calculated measurement is the ratio of the density of urine to the density of water at a given temperature and pressure.</obo:IAO_0000115>
