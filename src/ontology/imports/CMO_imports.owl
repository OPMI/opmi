    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002594 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002594">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood pressure time series average exponential scaling factor of the baroreceptor response</rdfs:label>
