    <!-- http://purl.obolibrary.org/obo/CMO_0000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000024">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated differential white blood cell count</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000366"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002341"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-12-13T10:32:58Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement which has been normalized, adjusted or derived by a mathematical process or computation, of one or more of the various, specific types of leukocytes present in a sample of blood for which a total white blood cell count was taken, usually 1 cubic mm of peripheral venous blood.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000024</oboInOwl:id>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated blood differential WBC count</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated blood differential leukocyte count</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mshimoyama</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000026">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood hemoglobin level</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000028"/>
