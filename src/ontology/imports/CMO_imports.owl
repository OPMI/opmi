    <!-- http://purl.obolibrary.org/obo/CMO_0002911 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002911">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated ventricle contraction measurement</rdfs:label>
