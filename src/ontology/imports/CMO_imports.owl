    <!-- http://purl.obolibrary.org/obo/CMO_0001177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001177">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney protein/peptide composition measurement</rdfs:label>
