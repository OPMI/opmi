    <!-- http://purl.obolibrary.org/obo/CMO_0000264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000264">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P wave duration</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000230"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-06-17T12:39:11Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000264</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EFO:0005094</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The time from start to finish of the P wave , in the electrocardiograph illustrating the initial deflection of the cardiac cycle, representing the excitation of the atria.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mshimoyama</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000265 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000265">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q wave depth</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000230"/>
