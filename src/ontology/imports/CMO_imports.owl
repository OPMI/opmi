    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003685 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003685">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio of renal plasma flow to kidney weight (inulin)</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001915"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003683"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-03-30T11:58:32Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the renal plasma flow rate (RPF) is divided by weight (i.e. the heaviness or the degree to which an object is drawn toward the earth by gravity) of one kidney and presented as a ratio, fraction, quotient or percentage. The RPF is the amount of plasma that perfuses the renal tubules per unit time, derived by measurement of the clearance rate of the indigestible polysaccharide inulin.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003685</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RGD:25314254</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0002847</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio of RPF to kidney weight (inulin)</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slaulede</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003686 -->

