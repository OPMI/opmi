    <!-- http://purl.obolibrary.org/obo/CMO_0000263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000263">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P wave amplitude</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000230"/>
