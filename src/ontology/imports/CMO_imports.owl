        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000268">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">QRS amplitude</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000230"/>
