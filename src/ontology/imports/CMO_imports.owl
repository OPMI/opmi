    <!-- http://purl.obolibrary.org/obo/CMO_0002909 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002909">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heart left ventricle end-diastolic elastance</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002911"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-03T16:21:42Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002909</oboInOwl:id>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Eed</oboInOwl:hasExactSynonym>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Left ventricle end-diastolic elastance (Eed) is the estimate of the slope of the line Ped = Eed(Ved-V0), which is based on linear regression of points determined by iterative calculation of the LV end-diastolic pressure-volume relationship.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0010750</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sjwang</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


