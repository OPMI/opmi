    <!-- http://purl.obolibrary.org/obo/CMO_0002885 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002885">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arterial elastance</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002884"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-11-27T15:23:57Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002885</oboInOwl:id>
