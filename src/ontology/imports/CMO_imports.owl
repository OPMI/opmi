        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002378"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-07-24T16:17:10Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003504</oboInOwl:id>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:978-1416049982</oboInOwl:hasDbXref>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The number of individuals in a study population which develop new instances of renal vascular pathology during a period of time compared to the total number of individuals in the study population, expressed as a percentage.</obo:IAO_0000115>
