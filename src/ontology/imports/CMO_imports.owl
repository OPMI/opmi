    <!-- http://purl.obolibrary.org/obo/CMO_0000125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000125">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">urine creatinine level</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000256"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2009-12-17T11:00:47Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:16737</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000125</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measurement of the amount of creatinine in a specified sample of urine, the fluid waste product excreted by the kidneys. Creatinine is a nitrogenous compound formed in muscle as the end product of creatine metabolism. Blood and urine tests for creatinine are used as diagnostic indicators of kidney function and muscle mass.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VT:0010540</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mshimoyama</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


