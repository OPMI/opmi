        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">absolute change in arterial blood flow rate</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000748"/>
