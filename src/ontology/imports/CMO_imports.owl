        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-11-27T15:38:49Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calculated measurement in which the maximum rate of positive change in left ventricular blood pressure is divided by the left ventricular end-diastolic volume, and the result presented as a ratio, fraction, quotient or percentage.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0002889</oboInOwl:id>
