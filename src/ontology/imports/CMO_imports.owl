        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesenteric artery phosphylated eNOS protein level to total eNOS protein level ratio</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesenteric artery wall phosphylated eNOS level to total eNOS level ratio</oboInOwl:hasExactSynonym>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sjwang</oboInOwl:created_by>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002853 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002853">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aorta wall phosphorylated eNOS level to total eNOS level ratio</rdfs:label>
