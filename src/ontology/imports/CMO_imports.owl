    <!-- http://purl.obolibrary.org/obo/CMO_0000677 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000677">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organ lesion measurement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000669"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-02-15T05:45:18Z</oboInOwl:creation_date>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000677</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measurement of a lesion in an organ. A lesion is a localized pathological change in structure of an organ or tissue due to injury or disease; especially one that is circumscribed and well defined.</obo:IAO_0000115>
