        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0000994</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The extent of shortening of the minor internal circumference (at the midpoint of the long axis) between end-diastole and end-systole, divided by the time required for shortening.</obo:IAO_0000115>
