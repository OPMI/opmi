        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">myeloid white cell count</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">white corpuscle count</oboInOwl:hasRelatedSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000028">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood protein measurement</rdfs:label>
