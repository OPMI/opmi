    <!-- http://purl.obolibrary.org/obo/CMO_0003219 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003219">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated heart left ventricle end-diastolic diameter</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000982"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-07-25T14:06:48Z</oboInOwl:creation_date>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement which has been normalized, adjusted or derived by a mathematical process or computation, of the heart left ventricle end-diastolic internal diameter.</obo:IAO_0000115>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CMO:0003219</oboInOwl:id>
