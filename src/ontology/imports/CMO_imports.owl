        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002595 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002595">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood pressure time series linear term first order parameter</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002589"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-09-11T18:33:18Z</oboInOwl:creation_date>
