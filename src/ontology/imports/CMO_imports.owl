    <!-- http://purl.obolibrary.org/obo/CMO_0002986 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002986">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glomerular transcapillary hydraulic pressure gradient</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002536"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-27T15:27:01Z</oboInOwl:creation_date>
