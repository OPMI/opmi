        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jsmith</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney paraoxonase-1 activity to total protein level ratio</oboInOwl:hasExactSynonym>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
    </owl:Class>
    


