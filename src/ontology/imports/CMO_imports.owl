    <!-- http://purl.obolibrary.org/obo/CMO_0003476 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003476">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculated kidney copper weight</rdfs:label>
