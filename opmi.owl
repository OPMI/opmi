        <oboInOwl:hasExactSynonym>membrane of organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0000094</oboInOwl:id>
        <rdfs:label>membrane organ</rdfs:label>
    </owl:Class>
    


