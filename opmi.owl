        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000754</oboInOwl:id>
        <rdfs:label>percent change in left ventricular systolic blood pressure</rdfs:label>
    </owl:Class>
    


