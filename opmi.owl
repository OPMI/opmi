        <oboInOwl:hasDbXref>EV:0100002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:85521</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:1311</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000281</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:A16.254.610</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000135</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0028439</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000199</oboInOwl:hasDbXref>
