    <!-- http://purl.obolibrary.org/obo/ENVO_03000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_03000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002234"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
