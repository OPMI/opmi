        <oboInOwl:hasExactSynonym>systolic blood pressure change measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000746</oboInOwl:id>
        <rdfs:label>change in systolic blood pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000747 -->

