        <obo:IAO_0000115>Ontology is a formal representation of knowledge as a set of concepts (classes), relationships, and terms within a domain, often with defined meanings and logical structure.</obo:IAO_0000115>
        <obo:IAO_0000117>Yujia Tian</obo:IAO_0000117>
        <rdfs:label xml:lang="en">ontology</rdfs:label>
    </owl:Class>
    


