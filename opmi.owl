    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030831">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0030829"/>
        <obo:IAO_0000115>Abnormal breath sounds characterized by low-pitched, snoring or rattle-like sounds.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <rdfs:label>Rhonchi</rdfs:label>
    </owl:Class>
    


