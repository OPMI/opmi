        <rdfs:label xml:lang="en">device exposure temporal region</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000556"/>
        <obo:IAO_0000115>The date on which a device exposure ends.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Long Tran</obo:IAO_0000117>
        <obo:IAO_0000119>http://ohdsi.github.io/CommonDataModel/cdm54.html#DEVICE_EXPOSURE</obo:IAO_0000119>
        <rdfs:comment>&quot;Put the end date or discontinuation date as it appears from the source data or leave blank if unavailable.&quot; http://ohdsi.github.io/CommonDataModel/cdm54.html#DEVICE_EXPOSURE</rdfs:comment>
        <rdfs:label xml:lang="en">device exposure end date</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000558 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000556"/>
        <obo:IAO_0000115>The date and time on which a device exposure ends.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Long Tran</obo:IAO_0000117>
        <obo:IAO_0000119>http://ohdsi.github.io/CommonDataModel/cdm54.html#DEVICE_EXPOSURE</obo:IAO_0000119>
        <rdfs:comment>&quot;If a source does not specify datetime the convention is to set the time to midnight (00:00:0000).&quot; http://ohdsi.github.io/CommonDataModel/cdm54.html#DEVICE_EXPOSURE</rdfs:comment>
        <rdfs:label xml:lang="en">device exposure end datetime</rdfs:label>
    </owl:Class>
    


