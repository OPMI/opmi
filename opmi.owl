    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0001481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001478"/>
        <obo:IAO_0000115>The maximum speed at which the blood flows through the aorta during the cardiac cycle, expressed as distance per unit of time.</obo:IAO_0000115>
