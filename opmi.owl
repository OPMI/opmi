                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001838"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001839"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001840"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">a urinary system AE that results in the presence of blood in the urine</obo:IAO_0000115>
        <obo:IAO_0000117>YH, SJ, MW</obo:IAO_0000117>
        <obo:IAO_0000118>UMLS CUI: C0018965 (hematuria AND haematuria); UMLS CUI: C0947999 (blood urine presence)</obo:IAO_0000118>
        <obo:IAO_0000118>blood urine</obo:IAO_0000118>
        <obo:IAO_0000118>blood urine presence</obo:IAO_0000118>
        <obo:IAO_0000118>haematuria AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://kidney.niddk.nih.gov/kudiseases/pubs/hematuria/</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/oae.owl"/>
        <obo:OAE_0004334>10018867</obo:OAE_0004334>
        <obo:OAE_0004334>10018870</obo:OAE_0004334>
        <obo:OAE_0004334>10019450</obo:OAE_0004334>
        <oboInOwl:hasExactSynonym>hematuria</oboInOwl:hasExactSynonym>
        <rdfs:comment>Hematuria AE can be caused by menstruation, vigorous exercise, sexual activity, viral illness, trauma, or infection, such as a urinary tract infection (UTI), along with more serious disorders such as cancer, disease, and clotting.</rdfs:comment>
        <rdfs:label>hematuria AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E13000</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0005161</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C3090</rdfs:seeAlso>
    </owl:Class>
    


