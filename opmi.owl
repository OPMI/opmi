        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000272</oboInOwl:id>
        <rdfs:label>S wave amplitude</rdfs:label>
    </owl:Class>
    


