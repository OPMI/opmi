    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003489 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003488"/>
        <obo:IAO_0000115>The tuft surface area is defined as the total glomerular surface area minus the urinary space area and the urinary recesses.</obo:IAO_0000115>
