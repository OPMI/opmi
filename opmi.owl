        <oboInOwl:hasDbXref>EFO:0008390</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VT:0002551</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>prothrombin time measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000211</oboInOwl:id>
        <rdfs:label>prothrombin time</rdfs:label>
    </owl:Class>
    


