        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000139"/>
        <obo:IAO_0000115 xml:lang="en">A surgeon role realized by its bearer using performing neurosurgery.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
        <rdfs:label xml:lang="en">neurosurgereon role</rdfs:label>
    </owl:Class>
    


