        <obo:IAO_0000119 xml:lang="zh">《电子病历基本数据集 第10部分：住院病案首页》WS 445.10-2014</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
