    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000728 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000728">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000718"/>
