        <oboInOwl:hasDbXref>FMA:295662</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0001185</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1518973</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001680</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000029</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001185</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>skin periderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
