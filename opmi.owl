        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000268</oboInOwl:id>
        <rdfs:label>QRS amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000269 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000230"/>
        <obo:IAO_0000115>QT interval corrected for heart rate calculated by the QT interval divided by the square root of the interval from one QRS complex to the onset of the next QRS complex measured in seconds.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-06-17T12:40:52Z</oboInOwl:creation_date>
