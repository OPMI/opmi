        <oboInOwl:hasExactSynonym>peak aortic blood flow velocity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>peak of aortic outflow velocity (PAV)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0001481</oboInOwl:id>
        <rdfs:label>peak aortic velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0001482 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000662"/>
        <obo:IAO_0000115>The length of time in the cardiac cycle between the closing of the aortic and pulmonic/pulmonary semilunar valves and opening of the atrioventricular (AV) valves marking the beginning of ventricular filling. Used as an indicator of diastolic dysfunction.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
