        <oboInOwl:hasDbXref>ISBN:978-1416049982</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>renal copper weight to renal wet weight ratio</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0003480</oboInOwl:id>
        <rdfs:label>kidney copper weight to kidney wet weight ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003481 -->

