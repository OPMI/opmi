        <obo:IAO_0000115>The amount of bradykinin collected from the intercellular spaces of the left ventricle myocardium over a designated period of time.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
