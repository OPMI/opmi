    <!-- http://purl.obolibrary.org/obo/OAE_0004431 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <obo:IAO_0000115>An adverse event of surgery that leads to the puncturing of an adjacent organ. For example, a needle to the kidney may puncture the adjacent organs.</obo:IAO_0000115>
