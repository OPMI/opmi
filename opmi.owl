        <oboInOwl:hasOBONamespace>GAZ</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GAZ:00002459</oboInOwl:id>
        <rdfs:label>United States of America</rdfs:label>
    </rdf:Description>
