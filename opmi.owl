        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0001180</oboInOwl:id>
        <rdfs:label>renal medulla protein measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0001181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001178"/>
        <obo:IAO_0000115>Any measurement involving the amount, composition or type of protein, the complex organic compounds containing carbon, hydrogen, oxygen, nitrogen, and sulfur consisting of alpha-amino acids joined by peptide linkages, in renal cortex, the outer part of the kidney, composed mainly of glomeruli and convoluted tubules.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
