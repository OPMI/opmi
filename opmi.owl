    <!-- http://purl.obolibrary.org/obo/CMO_0000292 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000008"/>
        <obo:IAO_0000115>The difference between systolic and diastolic blood pressures, i.e. the difference between the maximal arterial pressure and minimal arterial pressure during the cardiac cycle.</obo:IAO_0000115>
