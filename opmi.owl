        <obo:IAO_0000111>informed consent process</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115>A planned process in which a person or their legal representative is informed about key facts about potential risks and benefits of a process and makes a documented decision as to whether the person in question will participate.</obo:IAO_0000115>
        <obo:IAO_0000116>09/28/2009 Alan Ruttenberg: This is made a subclass of the higher level processual entity in BFO because I don&apos;t want to take a stand on whether it is a process aggregate. Analogous to the situation with Material entity.</obo:IAO_0000116>
        <obo:IAO_0000117>Person:Alan Ruttenberg</obo:IAO_0000117>
        <obo:IAO_0000119>http://clinicaltrials.gov/ct2/info/glossary#informed</obo:IAO_0000119>
        <obo:IAO_0000232>2009/09/28 Alan Ruttenberg. Fucoidan-use-case</obo:IAO_0000232>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label>informed consent process</rdfs:label>
    </owl:Class>
    


