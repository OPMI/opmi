        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000275"/>
        <obo:IAO_0000112>As part of the OMOP CDM, populate this field based on the provenance of the visit record, as in whether it came from an EHR record or billing claim.</obo:IAO_0000112>
        <obo:IAO_0000115>An electronic health record that records the information of medical  visit.</obo:IAO_0000115>
        <obo:IAO_0000117>Long Tran, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000118>Visit Type Concept</obo:IAO_0000118>
        <obo:IAO_0000119>https://ohdsi.github.io/CommonDataModel/cdm54.html#PROCEDURE_OCCURRENCE</obo:IAO_0000119>
        <rdfs:label xml:lang="en">electronic medical visit record</rdfs:label>
    </owl:Class>
    


