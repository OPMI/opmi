    <!-- http://purl.obolibrary.org/obo/CMO_0002909 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002909">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002911"/>
        <obo:IAO_0000115>Left ventricle end-diastolic elastance (Eed) is the estimate of the slope of the line Ped = Eed(Ved-V0), which is based on linear regression of points determined by iterative calculation of the LV end-diastolic pressure-volume relationship.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>sjwang</oboInOwl:created_by>
