        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000656</oboInOwl:id>
        <rdfs:label>heart right ventricle dry weight</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000662 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000662">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000670"/>
        <obo:IAO_0000115>Any measurement of components of the periodic tightening and loosening of the heart muscle.</obo:IAO_0000115>
