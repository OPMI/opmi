        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002884"/>
        <obo:IAO_0000115>Effective arterial elastance (Ea), defined as the ratio of left ventricular end-systolic pressure (Pes) to stroke volume (SV), provides a convenient, useful method to assess arterial load.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
