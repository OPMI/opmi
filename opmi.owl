    <!-- http://purl.obolibrary.org/obo/UBERON_0003714 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002577"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005291"/>
