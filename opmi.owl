    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000230"/>
        <obo:IAO_0000115>The time from start to finish of the S wave which is the downward deflection of the QRS complex following the R wave representing late depolarization as illustrated by an electrocardiograph.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
