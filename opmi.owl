    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003504 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002378"/>
        <obo:IAO_0000115>The number of individuals in a study population which develop new instances of renal vascular pathology during a period of time compared to the total number of individuals in the study population, expressed as a percentage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>slaulede</oboInOwl:created_by>
