    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000596 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000275"/>
        <obo:IAO_0000115>An electronic health record that records the information of medical measurement record.</obo:IAO_0000115>
