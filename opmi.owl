    <!-- http://purl.obolibrary.org/obo/CMO_0002955 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002955">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003711"/>
