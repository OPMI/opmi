    <!-- http://purl.obolibrary.org/obo/CMO_0000201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000195"/>
        <obo:IAO_0000115>This is a measurement of the tangential force of the flowing blood on the endothelial surface of the blood vessel. The value is defined by the Hagen-Poiseuille equation (τ = 4μQ/πR3, where τ is the shear stress, μ is the blood viscosity, Q is the volumetric flow rate, and R is the lumen radius).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-06-10T10:04:04Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>blood vessel shear stress measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000201</oboInOwl:id>
        <rdfs:label>vessel shear stress measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000201"/>
        <obo:IAO_0000115>This is a measurement of the tangential force of flowing blood on the endothelial surface of an in vitro blood vessel or other experimental support. The experimental set-up may use steady, nonpulsatile laminar shear stress, pulsatile laminar shear stress, or nonlaminar oscillatory shear stress.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-06-10T10:51:43Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>in vitro blood vessel shear stress</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000202</oboInOwl:id>
        <rdfs:label>in vitro vessel shear stress</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000201"/>
        <obo:IAO_0000115>This is a measurement of shear stress in a model organism by the experimental creation of an arteriovenous fistula, ligation of vessels, or transposition of a vein graft into the arterial circulation.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-06-10T10:52:06Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>in vivo blood vessel shear stress</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000203</oboInOwl:id>
        <rdfs:label>in vivo vessel shear stress</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000035"/>
        <obo:IAO_0000115>Measurement of coagulation and factors affecting coagulation in blood after removal from the living organism.</obo:IAO_0000115>
