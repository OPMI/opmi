        <rdfs:label>heart right atrium weight to tibia length ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000450"/>
