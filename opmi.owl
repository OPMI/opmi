        <obo:IAO_0000115>A calculated measurement in which the area of the heart left ventricle occupied by interstitial collagen is divided by the total area of the heart left ventricle, and the result presented as a ratio, fraction, quotient or percentage.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
