        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">An inclusion criterion defines that a human being has to be a hospital patient to be suitable for a given task or participation in a given process.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">hospital patient inclusion criterion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002560 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002560">
