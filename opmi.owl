            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
        <rdfs:label xml:lang="en">surgeon role</rdfs:label>
    </owl:Class>
    


