        <oboInOwl:hasOBONamespace>GAZ</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GAZ:00002846</oboInOwl:id>
        <rdfs:label>Northeast Asia</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/GAZ_00281547 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/GAZ_00281547">
        <obo:RO_0001025 rdf:resource="http://purl.obolibrary.org/obo/GAZ_00000464"/>
        <obo:IAO_0000115>A group of islands off the northwest coast of continental Europe that include the islands of Great Britain and Ireland, and over six thousand smaller islands. There are two sovereign states located on the islands: the United Kingdom and the Republic of Ireland. The British Isles also include two dependencies of the United Kingdom: the Isle of Man and, by tradition, the Channel Islands, although the latter are not physically a part of the island group.</obo:IAO_0000115>
        <oboInOwl:created_by>michaelashburner</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-05-16T10:11:46Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>GAZ</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GAZ:00281547</oboInOwl:id>
        <rdfs:label>British Isles</rdfs:label>
    </owl:NamedIndividual>
    


