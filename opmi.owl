    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0001545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000196"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001544"/>
        <obo:IAO_0000115>The volume of fluid flowing into, out of or through the blood vessels and microvasculature of the myocardium, the thick contractile middle layer of uniquely constructed and arranged muscle cells that forms the bulk of the heart wall, per unit time.</obo:IAO_0000115>
