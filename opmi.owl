            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000578"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A period time when an observation is conducted.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Long Tran</obo:IAO_0000117>
        <obo:IAO_0000118>participant observation duration time</obo:IAO_0000118>
        <obo:IAO_0000119>https://ohdsi.github.io/CommonDataModel/cdm60.html#OBSERVATION_PERIOD</obo:IAO_0000119>
        <rdfs:comment>In OMOP, the observation table contains records that defines spans of time during which two conditions are expected to hold: (i) Clinical Events that happened to the Person are recorded in the Event tables, and (ii) absense of records indicate such Events did not occur during this span of time.</rdfs:comment>
        <rdfs:label xml:lang="en">observation period</rdfs:label>
        <rdfs:seeAlso>EUPATH_0000138</rdfs:seeAlso>
    </owl:Class>
    


