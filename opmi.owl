        <rdfs:label>pulse</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000089"/>
        <obo:IAO_0000115>The total amount of body fat calculated as fat mass index equal to fat weight divided by height squared.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
