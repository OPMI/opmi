    <!-- http://purl.obolibrary.org/obo/CMO_0002903 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000907"/>
        <obo:IAO_0000115>Renal medullary blood flow (MBF) is the volume of blood delivered to or exiting from the renal medulla per unit time.</obo:IAO_0000115>
