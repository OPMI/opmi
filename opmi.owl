        <oboInOwl:hasExactSynonym>LVdP/dtmin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0003288</oboInOwl:id>
        <rdfs:label>minimum rate of positive change in left ventricular blood pressure</rdfs:label>
    </owl:Class>
    


