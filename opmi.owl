        <rdfs:label xml:lang="en">medical procedure occurrence</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000578"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000505"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A centrally registered identifier that refers to a procedure occurrence, which is an activity or process that is ordered by, or carried out by, a healthcare provider on a patient with a diagnostic or therapeutic purpose.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Long Tran</obo:IAO_0000117>
