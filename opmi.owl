    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GAZ_00000448">
        <obo:IAO_0000111>geographic location</obo:IAO_0000111>
        <obo:IAO_0000115>A reference to a place on the Earth, by its name or by its geographical location.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/gaz.owl"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
