    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002559 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0500027"/>
