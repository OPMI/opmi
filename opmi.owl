    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001474"/>
        <obo:IAO_0000115>Any measurement of the movement of blood through the aorta, the great artery arising from the left ventricle from which the systemic arterial system proceeds.</obo:IAO_0000115>
