    <!-- http://purl.obolibrary.org/obo/CMO_0000753 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000753">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000007"/>
