        <oboInOwl:hasDbXref>VT:0005325</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>renal glomerulus basement membrane thickness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0003401</oboInOwl:id>
        <rdfs:label>kidney glomerulus basement membrane thickness</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003402 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002247"/>
        <obo:IAO_0000115>A calculated value made by dividing the mesangial fraction volume by the total glomerular volume, both values having been calculated from measurements of microscopic images.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
