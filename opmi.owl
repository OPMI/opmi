            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A diagnosis-related group (DRG) source value that refers to the classification code for hospital cases (used in the U.S.), as recorded in the original data source.</obo:IAO_0000115>
        <obo:IAO_0000117>Yujia Tian</obo:IAO_0000117>
        <obo:IAO_0000118>drg_source_value</obo:IAO_0000118>
        <obo:IAO_0000119>https://ohdsi.github.io/CommonDataModel/cdm54.html#cost</obo:IAO_0000119>
        <rdfs:label xml:lang="en">drg source value</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000675 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000675">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000635"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000479"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An episode source value that refers to the original code for the episode recorded in the source data. This code is mapped to a standard condition concept, and the original value is stored here.</obo:IAO_0000115>
        <obo:IAO_0000117>Yujia Tian</obo:IAO_0000117>
        <obo:IAO_0000118>episode_source_value</obo:IAO_0000118>
        <obo:IAO_0000119>https://ohdsi.github.io/CommonDataModel/cdm54.html#episode</obo:IAO_0000119>
        <rdfs:label xml:lang="en">episode source value</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000676 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000676">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000482"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A medical vist that occurs within the scope of a parent medical visit. Each subvisit represents a meaningful subdivision of the overall visit, such as a change in care setting, a specific unit stay, or an individual service episode (e.g., a claim line), and is linked to a single parent visit.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He, Yujia Tian</obo:IAO_0000117>
        <obo:IAO_0000118>detail visit</obo:IAO_0000118>
        <obo:IAO_0000118>nested visit</obo:IAO_0000118>
        <obo:IAO_0000118>subvisit</obo:IAO_0000118>
        <obo:IAO_0000118>visit episode</obo:IAO_0000118>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Inpatient_care</obo:IAO_0000119>
        <rdfs:label xml:lang="en">medical subvisit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000677 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000564"/>
        <obo:IAO_0000115>It is based on drug exposure table to combined all exposures close enough into a single drug era.</obo:IAO_0000115>
        <obo:IAO_0000117>Yujia Tian</obo:IAO_0000117>
        <obo:IAO_0000119>http://ohdsi.github.io/CommonDataModel/cdm54.html#DRUG_EXPOSURE</obo:IAO_0000119>
        <rdfs:label xml:lang="en">drug era</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000678 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000678">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000527"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>condition_era groups multiple, closely timed occurrences of the same diagnosis into one interval, making analysis of prevalence, duration, and chronicity much easier and more accurate</obo:IAO_0000115>
        <obo:IAO_0000117>Yujia Tian</obo:IAO_0000117>
        <obo:IAO_0000118>condition_era</obo:IAO_0000118>
        <rdfs:label xml:lang="en">medical condition era</rdfs:label>
    </owl:Class>
    


