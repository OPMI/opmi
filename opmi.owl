                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An investigation that is targeted for precision medicine</obo:IAO_0000115>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Precision_medicine</obo:IAO_0000119>
        <rdfs:label xml:lang="en">precision medicine investigation</rdfs:label>
    </owl:Class>
    


