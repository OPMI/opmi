    <!-- http://purl.obolibrary.org/obo/MONDO_0005083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0005083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002406"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100118"/>
        <obo:IAO_0000115>An autoimmune condition characterized by red, well-delineated plaques with silvery scales that are usually on the extensor surfaces and scalp. They can occasionally present with these manifestations: pustules; erythema and scaling in intertriginous areas, and erythroderma, that are often distributed on extensor surfaces and scalp.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mondo.owl"/>
        <mondo:curated_content_resource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.malacards.org/card/psoriasis</mondo:curated_content_resource>
        <mondo:should_conform_to rdf:resource="http://purl.obolibrary.org/obo/mondo/patterns/OMIM_phenotypic_series.yaml"/>
