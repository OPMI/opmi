    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000039"/>
        <obo:IAO_0000115 xml:lang="en">A role that inheres in an organism and is realized by habitually smoking 10 or more tobacco cigerettes a day or the equivalent in other tobacco products.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
        <rdfs:label xml:lang="en">heavy smoker role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OMRSE_00000187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000039"/>
        <obo:IAO_0000115 xml:lang="en">A role that inheres in an organism and is realized by habitually smoking 1&gt;10 tobacco cigerettes a day or the equivalent in other tobacco products.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
        <rdfs:label xml:lang="en">light smoker role</rdfs:label>
    </owl:Class>
    


