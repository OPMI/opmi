    <!-- http://purl.obolibrary.org/obo/OPMI_0004505 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0004505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000178"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0004492"/>
        <rdfs:label xml:lang="en">Whether diabetes during pregnancy</rdfs:label>
