    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C16358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C19332"/>
        <obo:IAO_0000115>An individual&apos;s weight in kilograms divided by the square of the height in meters.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_A24 rdf:resource="http://purl.obolibrary.org/obo/NCIT_C49672"/>
