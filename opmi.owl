        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0003244</oboInOwl:id>
        <rdfs:label>ratio of the area occupied by interstitial collagen to the total area of the heart left ventricle</rdfs:label>
    </owl:Class>
    


