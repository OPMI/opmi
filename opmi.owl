    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003418 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003419"/>
        <obo:IAO_0000115>In the physiology of the kidney, free water clearance is the volume of blood plasma that is cleared of solute-free water per unit time. A free water clearance of zero means the kidney is producing urine isotonic with respect to the plasma. Values greater than zero for free water clearance imply that the kidney is producing dilute urine through the excretion of solute-free water.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>slaulede</oboInOwl:created_by>
        <oboInOwl:creation_date>2020-05-28T14:54:46Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>PMID:23955305</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>renal water clearance</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CMO:0003418</oboInOwl:id>
        <rdfs:label>free water clearance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003419 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000906"/>
        <obo:IAO_0000115>Any measurement relating to the function of the kidney or any part thereof. The kidney functions to maintain proper water and electrolyte balance, regulate acid-base concentration, and filter the blood of metabolic wastes.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>slaulede</oboInOwl:created_by>
        <oboInOwl:creation_date>2020-05-28T14:59:47Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>renal physiological measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0003419</oboInOwl:id>
        <rdfs:label>kidney physiological measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0003420 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003419"/>
        <obo:IAO_0000115>A measurement of kidney function which has been normalized, adjusted or derived by a mathematical process or computation.</obo:IAO_0000115>
