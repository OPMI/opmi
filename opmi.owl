        <oboInOwl:hasDbXref rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C33007"/>
        <oboInOwl:hasDbXref>FMA:19783</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1253917</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>textus connectivus collagenosus laxus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>textus connectivus laxus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0011825</oboInOwl:id>
        <rdfs:label>loose connective tissue</rdfs:label>
    </owl:Class>
    


