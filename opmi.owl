        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0030829"/>
        <obo:IAO_0000115>A high-pitched whistling sound associated with labored breathing.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <rdfs:label>Wheezing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0030829 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002795"/>
