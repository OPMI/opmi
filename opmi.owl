    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0003944"/>
        <obo:IAO_0000115>Portion of the body not comprised of lipids often calculated as fat free mass equal to fat free mass divided by height squared.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-08-05T09:21:40Z</oboInOwl:creation_date>
