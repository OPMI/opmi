    <!-- http://purl.obolibrary.org/obo/UBERON_0003055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000487"/>
