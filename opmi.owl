        <oboInOwl:hasDbXref>VHOG:0000114</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000259</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000255</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>paraxial mesenchyme</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>somitic mesoderm</oboInOwl:hasExactSynonym>
