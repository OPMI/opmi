    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000300"/>
        <obo:IAO_0000115 xml:lang="en">A textual entity represents the free text note prvide from provider about a patient notes in given date</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Yujia Tian</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">clinical note</rdfs:comment>
        <rdfs:label>clinical note</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000680 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000680">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>Vocabulary have few related definitions, in linguistics or data science a vocabulary can mean a set of recognized terms or tokens</obo:IAO_0000115>
        <obo:IAO_0000117>Yujia Tian</obo:IAO_0000117>
        <rdfs:label xml:lang="en">vocabulary</rdfs:label>
    </owl:Class>
    


