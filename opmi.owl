        <oboInOwl:id>CMO:0000664</oboInOwl:id>
        <rdfs:label>time to peak heart contraction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000665 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000665">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000662"/>
        <obo:IAO_0000115>Pressure exerted by the heart muscle in its maximally contracted state.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>jsmith</oboInOwl:created_by>
