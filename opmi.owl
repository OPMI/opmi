    <!-- http://purl.obolibrary.org/obo/CMO_0003488 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0003488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001165"/>
        <obo:IAO_0000115>The measurement of the total glomerular surface area as delimited by the internal edge of Bowman&apos;s capsule.</obo:IAO_0000115>
