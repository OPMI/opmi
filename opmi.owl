        <oboInOwl:hasDbXref>EMAPA:16303</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16528</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:295618</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0814993</oboInOwl:hasDbXref>
