    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000598 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000598">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000275"/>
        <obo:IAO_0000115>An electronic health record that records the information of medical observational record.</obo:IAO_0000115>
        <obo:IAO_0000117>Long Tran, Oliver He</obo:IAO_0000117>
