    <!-- http://purl.obolibrary.org/obo/UBERON_0000481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002577"/>
