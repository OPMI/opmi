        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>A process of a dynamic system that produces an identiical or similar copy of itself.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Self-replication</obo:IAO_0000119>
        <rdfs:label xml:lang="en">self-replication</rdfs:label>
    </owl:Class>
    


