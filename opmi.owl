        <oboInOwl:hasDbXref>EHDAA:207</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000094</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TE:E5.11.2.0.0.0.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1511224</oboInOwl:hasDbXref>
