        <obo:IAO_0000115>The systolic and diastolic blood pressure of the newborn upon examination; the normal range of the systolic blood pressure is 60 - 90, while the normal range of the diastolic blood pressure is 20-60.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C87105</obo:NCIT_NHC0>
        <obo:NCIT_P106>Clinical Attribute</obo:NCIT_P106>
        <obo:NCIT_P108>Newborn Blood Pressure</obo:NCIT_P108>
        <obo:NCIT_P207>C2828171</obo:NCIT_P207>
        <obo:NCIT_P322>NICHD</obo:NCIT_P322>
        <oboInOwl:hasExactSynonym>Newborn Blood Pressure</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/NCIT_C89506"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/NCIT_C90259"/>
        <rdfs:label>Newborn Blood Pressure</rdfs:label>
    </owl:Class>
    


