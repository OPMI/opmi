        <oboInOwl:hasExactSynonym>ceases_to_exist_during</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>existence_ends_during</oboInOwl:id>
        <oboInOwl:shorthand>existence_ends_during</oboInOwl:shorthand>
        <rdfs:label>existence ends during</rdfs:label>
    </owl:ObjectProperty>
    


