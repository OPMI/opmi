    <!-- http://purl.obolibrary.org/obo/NCIT_C43390 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C43390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C17049"/>
        <obo:IAO_0000115>The native people inhabiting the Arctic of northern Canada, Greenland, Alaska, or eastern Siberia. The two main groups referred to as Eskimo are the Yupik and Inuit. A third group, the Aleut, is related. In Canada and Greenland, the term Eskimo has fallen out of favor, as it is considered pejorative by the natives and has been replaced by the term Inuit.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C43390</obo:NCIT_NHC0>
        <obo:NCIT_P106>Population Group</obo:NCIT_P106>
        <obo:NCIT_P108>Eskimo</obo:NCIT_P108>
        <obo:NCIT_P207>C0014845</obo:NCIT_P207>
        <obo:NCIT_P366>Eskimo</obo:NCIT_P366>
        <oboInOwl:hasExactSynonym>Eskimo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inuit</oboInOwl:hasExactSynonym>
        <rdfs:label>Eskimo</rdfs:label>
    </owl:Class>
    


