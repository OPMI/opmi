        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000680"/>
        <obo:IAO_0000115>Terminology refers to a set of specialized words or expressions used in a specific field, subject, or profession</obo:IAO_0000115>
        <obo:IAO_0000117>Yujia Tian</obo:IAO_0000117>
        <rdfs:label xml:lang="en">terminology</rdfs:label>
    </owl:Class>
    


