    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000423">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OPMI_0000623"/>
        <obo:IAO_0000115>An non-organism infectious agent that is composed solely of a short strand of circular, single-stranded RNA and has no protein coating.</obo:IAO_0000115>
        <obo:IAO_0000117>Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Mobile_genetic_elements</obo:IAO_0000119>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Viroid</obo:IAO_0000119>
        <rdfs:label xml:lang="en">viroid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000425 -->

