        <oboInOwl:hasRelatedSynonym>FHF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PHF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>heart field</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004140</oboInOwl:id>
        <rdfs:label>primary heart field</rdfs:label>
    </owl:Class>
    


