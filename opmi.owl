    <!-- http://purl.obolibrary.org/obo/OBI_0000443 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000417"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000437"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111>analyte assay</obo:IAO_0000111>
        <obo:IAO_0000112>example of usage: In lab test for blood glucose, the test is the assay, the blood bears evaluant_role and glucose bears the analyte role. The evaluant is considered an input to the assay and the information entity that records the measurement of glucose concentration the output</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115>An assay with the objective to capture information about the presence, concentration, or amount of an analyte in an evaluant.</obo:IAO_0000115>
        <obo:IAO_0000117>Alan Ruttenberg</obo:IAO_0000117>
        <obo:IAO_0000117>Bjoern Peters</obo:IAO_0000117>
        <obo:IAO_0000117>Helen Parkinson</obo:IAO_0000117>
        <obo:IAO_0000117>Philippe Rocca-Serra</obo:IAO_0000117>
        <obo:IAO_0000119>Alan Ruttenberg</obo:IAO_0000119>
        <obo:IAO_0000119>Bjoern Peters</obo:IAO_0000119>
        <obo:IAO_0000119>Helen Parkinson</obo:IAO_0000119>
        <obo:IAO_0000119>OBI Planned process branch</obo:IAO_0000119>
        <obo:IAO_0000119>Philippe Rocca-Serra</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label>analyte assay</rdfs:label>
    </owl:Class>
    


