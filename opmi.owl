        <obo:IAO_0000118>ecchymoses AE</obo:IAO_0000118>
        <obo:IAO_0000118>haematoma AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hematoma</obo:IAO_0000119>
