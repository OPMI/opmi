        <oboInOwl:hasDbXref>VT:0010486</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0002888</oboInOwl:id>
        <rdfs:label>preload recruitable left ventricle stroke work</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002889 -->

