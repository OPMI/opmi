        <oboInOwl:hasRelatedSynonym>epitrichium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>periderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003055</oboInOwl:id>
