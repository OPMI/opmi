    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002492 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002492">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002497"/>
