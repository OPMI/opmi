    <!-- http://purl.obolibrary.org/obo/CMO_0000737 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000737">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000719"/>
        <obo:IAO_0000115>Measurement of an organism&apos;s, organ&apos;s, tissue&apos;s or cell&apos;s capacity to respond, such as by a change in activity, state or condition, to acetylcholine (ACh), the ester of acetic acid and choline with chemical formula CH3C=OO(CH2)2-N(+)-(CH3)3 and IUPAC name 2-acetoxy-N,N,N-trimethylethanaminium, which acts as a neurotransmitter.</obo:IAO_0000115>
