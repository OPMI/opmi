        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>mean pulmonary artery (PA) pressure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CMO:0000778</oboInOwl:id>
        <rdfs:label>mean pulmonary arterial blood pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000782 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000003"/>
        <obo:IAO_0000115>Measurement of blood pressure in the pulmonary artery.</obo:IAO_0000115>
