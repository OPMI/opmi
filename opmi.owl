        <oboInOwl:hasDbXref>VT:0010750</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Eed</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0002909</oboInOwl:id>
        <rdfs:label>heart left ventricle end-diastolic elastance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002910 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002910">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000605"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0002915"/>
        <obo:IAO_0000115>Left ventricle end-systolic elastance (Ees) is the estimate of the slope of the line Pes = Ees(Ves-V0), which is based on linear regression of points determined by iterative calculation of the LV end-systolic pressure-volume relationship.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>sjwang</oboInOwl:created_by>
