    <!-- http://purl.obolibrary.org/obo/NCIT_C25352 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C25352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000035"/>
        <obo:IAO_0000115>A system, commonly called the INR, established by the World Health Organization (WHO) and the International Committee on Thrombosis and Hemostasis for reporting the results of blood coagulation (clotting) tests. All results are standardized using the international sensitivity index (ISI) for the particular thromboplastin reagent and instrument combination utilized to perform the test; the ratio of a patient&apos;s clotting time to the lab&apos;s mean reference value is normalized against the ISI. (from medterms.com and medicine.ucsf.edu)</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C25352</obo:NCIT_NHC0>
        <obo:NCIT_P106>Quantitative Concept</obo:NCIT_P106>
        <obo:NCIT_P108>International Normalized Ratio</obo:NCIT_P108>
        <obo:NCIT_P208>CL448971</obo:NCIT_P208>
        <obo:NCIT_P366>International_Normalized_Ratio</obo:NCIT_P366>
        <oboInOwl:hasExactSynonym>INR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>International Normalized Ratio</oboInOwl:hasExactSynonym>
        <rdfs:label>International Normalized Ratio</rdfs:label>
    </owl:Class>
    


