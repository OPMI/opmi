        <oboInOwl:id>CMO:0001425</oboInOwl:id>
        <rdfs:label>both kidneys dry weight</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0001426 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000170"/>
        <obo:IAO_0000115>The weight after desiccation of a single kidney, one of the paired organs which function to maintain proper water and electrolyte balance, regulate acid-base concentration, and filter the blood of metabolic wastes.</obo:IAO_0000115>
