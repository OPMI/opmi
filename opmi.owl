        <oboInOwl:id>CMO:0000539</oboInOwl:id>
        <rdfs:label>heart left ventricle dry weight</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000063"/>
        <obo:IAO_0000115>The amount of phosphorus, measured as inorganic phosphate, in a specified sample of serum.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
