        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0001181</oboInOwl:id>
        <rdfs:label>renal cortex protein measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0001182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001177"/>
        <obo:IAO_0000115>A measurement which has been normalized, adjusted or derived by a mathematical process or computation, of the composition, that is, the absolute amount, relative amount or type, of protein (the complex organic compounds containing carbon, hydrogen, oxygen, nitrogen, and sulfur consisting of alpha-amino acids joined by peptide linkages) in kidney.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>jsmith</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-10-22T03:34:08Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>calculated renal protein composition measurement</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CMO:0001182</oboInOwl:id>
        <rdfs:label>calculated kidney protein composition measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0001183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001181"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0001182"/>
        <obo:IAO_0000115>A measurement which has been normalized, adjusted or derived by a mathematical process or computation involving the amount, composition or type of protein in the kidney cortex, the outer part of the kidney, composed mainly of glomeruli and convoluted tubules.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
