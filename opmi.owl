        <obo:IAO_0000117>Long Tran, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>http://ohdsi.github.io/CommonDataModel/cdm54.html#PAYER_PLAN_PERIOD</obo:IAO_0000119>
        <rdfs:label xml:lang="en">payer plan temporal region</rdfs:label>
    </owl:Class>
    


