    <!-- http://purl.obolibrary.org/obo/CMO_0000672 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000672">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000671"/>
        <obo:IAO_0000115>The volume of a fluid flowing out of the heart.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
