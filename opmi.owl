        <oboInOwl:id>CMO:0000206</oboInOwl:id>
        <rdfs:label>in vitro coagulation measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000206"/>
        <obo:IAO_0000115>The time needed for plasma to form a fibrin clot after the addition of calcium and a phospholipid reagent. It is used to evaluate the intrinsic clotting system.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-06-10T11:20:31Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>EFO:0004310</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VT:0002551</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>partial thromboplastin time</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000210</oboInOwl:id>
        <rdfs:label>activated partial thromboplastin time</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000206"/>
        <obo:IAO_0000115>Measurement of the clotting ability of fibrinogen, prothrombin, proaccelerin, proconvertin and Stuart factor, usually given in seconds to formation of clot after the addition of a tissue factor or thromboplastin.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
