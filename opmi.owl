        <oboInOwl:hasDbXref>ZFA:0000091</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>axial chorda mesoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>chorda mesoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dorsal mesoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>presumptive notochord</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
        <oboInOwl:id>UBERON:0004880</oboInOwl:id>
