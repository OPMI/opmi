    <!-- http://purl.obolibrary.org/obo/NCIT_C92458 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C92458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C17468"/>
        <obo:IAO_0000115>The recognition that low neighborhood socioeconomic conditions have an impact on the services and opportunities available to its residents and have a wide and long-lasting effect on their economic, social and educational development. U.S. Census data can be used to determine the concentration of poverty at the neighborhood level.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C92458</obo:NCIT_NHC0>
        <obo:NCIT_P106>Classification</obo:NCIT_P106>
        <obo:NCIT_P108>Concentrated Disadvantage</obo:NCIT_P108>
        <obo:NCIT_P207>C2985113</obo:NCIT_P207>
        <oboInOwl:hasExactSynonym>Concentrated Disadvantage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Concentrated Neighborhood Disadvantage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neighborhood Concentrated Disadvantage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Neighborhood Disadvantage</oboInOwl:hasExactSynonym>
        <rdfs:label>Concentrated Disadvantage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C94488 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C94488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C25347"/>
        <obo:IAO_0000115>The height of a person while standing.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C94488</obo:NCIT_NHC0>
        <obo:NCIT_P106>Conceptual Entity</obo:NCIT_P106>
        <obo:NCIT_P108>Stature</obo:NCIT_P108>
        <obo:NCIT_P207>C0424639</obo:NCIT_P207>
        <obo:NCIT_P322>ACC/AHA</obo:NCIT_P322>
        <obo:NCIT_P325>A measurement that describes the vertical measurement or distance from the base, or bottom, of the patient, to the top of the patient; this can be taken as the dimension of extension of a patient who cannot stand.</obo:NCIT_P325>
        <obo:NCIT_P325>The height of a person while standing.</obo:NCIT_P325>
        <oboInOwl:hasExactSynonym>Stature</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Vital Signs – Height</oboInOwl:hasExactSynonym>
