        <oboInOwl:hasExactSynonym>populated places</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>settlement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>ENVO</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>inhabited region</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>populated locality</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ENVO:00000062</oboInOwl:id>
        <rdfs:label>populated place</rdfs:label>
    </owl:Class>
    


