    <!-- http://purl.obolibrary.org/obo/CMO_0000775 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000676"/>
        <obo:IAO_0000115>The activity level of LDH in effluent expressed relative to the weight of the heart; calculated as LDH activity divided by heart wet weight.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>jsmith</oboInOwl:created_by>
