        <oboInOwl:hasExactSynonym>Pes/SV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0002885</oboInOwl:id>
        <rdfs:label>arterial elastance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0002886 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0002886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000981"/>
        <obo:IAO_0000115>Defined as the work performed by the left or right ventricle to eject the stroke volume into the aorta or pulmonary artery, respectively.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
