        <rdfs:seeAlso>OMOP4976979</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OPMI_0000612 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OPMI_0000612">
