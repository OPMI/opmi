        <oboInOwl:hasDbXref>EMAPA:36033</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00000110</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:69069</oboInOwl:hasDbXref>
