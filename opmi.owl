        <rdfs:label>heart right ventricle weight</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000778 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000009"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000782"/>
        <obo:IAO_0000115>The average blood pressure within the pulmonary artery over a specified period of time, or technically over a complete cycle of one heartbeat.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>jsmith</oboInOwl:created_by>
