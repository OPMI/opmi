        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000015"/>
        <obo:IAO_0000115>The difference in body temperature between two different points in time or between two different conditions.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
