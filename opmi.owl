        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000663</oboInOwl:id>
        <rdfs:label>time to onset of heart contraction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000664 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000662"/>
        <obo:IAO_0000115>Measurement of the time from the beginning of heart muscle contraction to the maximum contracted state.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>jsmith</oboInOwl:created_by>
