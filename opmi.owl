        <oboInOwl:hasDbXref>OpenCyc:Mx4rvVi0GpwpEbGdrcN5Y29ycA</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000112</oboInOwl:hasDbXref>
