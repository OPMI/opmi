        <oboInOwl:id>CMO:0000269</oboInOwl:id>
        <rdfs:label>QTC interval</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000270 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000230"/>
        <obo:IAO_0000115>The magnitude of the R wave, which is the initial upward deflection of the QRS complex following the Q wave representing early depolarization of the ventricles as illustrated by an electrocardiograph.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-06-17T12:41:09Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>EFO:0007741</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>clinical_measurement_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CMO:0000270</oboInOwl:id>
        <rdfs:label>R wave amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000271 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000230"/>
        <obo:IAO_0000115>The time from start to finish of the R wave, the initial upward deflection of the QRS complex following the Q wave which represents early depolarization of the ventricles as illustrated in and electrocardiograph.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
