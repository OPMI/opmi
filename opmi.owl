        <obo:IAO_0000115 xml:lang="en">An inclusion criterion that defines and states one or more family statuses, which, if met, makes a human being suitable for a given task or participation in a given process.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Mathias Brochhausen</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">family status inclusion criterion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002561 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002561">
