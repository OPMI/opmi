    <!-- http://purl.obolibrary.org/obo/CMO_0000977 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000977">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000962"/>
        <obo:IAO_0000115>Measurement which has been normalized or adjusted by a mathematical process or computation of any localized pathological change in structure of a blood vessel due to injury or disease; especially one that is circumscribed and well defined.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>jsmith</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-07-26T02:13:01Z</oboInOwl:creation_date>
