        <obo:IAO_0000117>Oliver He, Edison Ong, Leon Li, Asiyah Lin</obo:IAO_0000117>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6044655/</obo:IAO_0000119>
