        <obo:IAO_0000115>The count of the rhythmic contractions and expansions of an artery due to the surge of blood from the beat of the heart.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
