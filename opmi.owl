    <!-- http://purl.obolibrary.org/obo/UBERON_0005068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016879"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000922"/>
            </owl:Restriction>
        </rdfs:subClassOf>
