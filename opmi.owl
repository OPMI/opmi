        <obo:IAO_0000115>Ashkenazi Jews, also called Ashkenazim, are Jews who are descendants of Jews from Germany, Poland, Austria and Eastern Europe.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
