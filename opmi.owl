        <oboInOwl:id>CMO:0000662</oboInOwl:id>
        <rdfs:label>heart contraction measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000663 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000663">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000662"/>
        <obo:IAO_0000115>Measure of the time from the relaxation of the heart muscle to the beginning of the tightening of the heart muscle during contraction.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>jsmith</oboInOwl:created_by>
