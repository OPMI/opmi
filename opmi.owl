        <oboInOwl:id>CMO:0000271</oboInOwl:id>
        <rdfs:label>R wave duration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0000272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0000272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000230"/>
        <obo:IAO_0000115>The magnitude of the S wave, the downward deflection of the QRS complex following the R wave representing late depolarization of the ventricles as illustrated in an electrocardiograph.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cmo.owl"/>
        <oboInOwl:created_by>mshimoyama</oboInOwl:created_by>
