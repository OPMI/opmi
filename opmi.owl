    <!-- http://purl.obolibrary.org/obo/OAE_0004428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0004428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <obo:IAO_0000115>An adverse event of hematoma in the subcapsular space of the kidney. This event occurs after a medical intervention, and may be caused by a tumor, trauma, vasculitis, renal infarction, or other disease process.</obo:IAO_0000115>
