    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMO_0001544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMO_0001544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMO_0000670"/>
        <obo:IAO_0000115>Any measurement of the thick contractile middle layer of uniquely constructed and arranged muscle cells that forms the bulk of the heart wall.</obo:IAO_0000115>
